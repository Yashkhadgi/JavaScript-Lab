# ========================
# Environment Variables
# Auth App with Session Detail
# ========================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017/auth_app
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/auth_app
MONGO_URI=mongodb://localhost:27017/auth_app

# --- JWT ---
JWT_SECRET=replace_this_with_a_long_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=1h

# --- SMTP (Mailtrap — recommended for testing) ---
# 1. Sign up free at https://mailtrap.io
# 2. Go to Email Testing > Inboxes > Show Credentials
# 3. Copy Host, Port, Username, Password below
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

# --- Gmail (alternative) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_char_app_password   # From: Google Account > Security > App Passwords

# --- SendGrid (alternative) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# --- Email Report Config ---
# Where to send activity reports
REPORT_EMAIL=admin@example.com
# Email address shown in the "From" field
REPORT_FROM="Auth App Reporter <noreply@authapp.com>"
# Set to true to send a "no activity" email when there are no new logs
SEND_EMPTY_REPORT=false
